{
  "name": "cookie-consent-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "preview": "serve out",
    "check:biome": "biome check .",
    "fix:biome": "biome check --write .",
    "check:types": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "next": "^16.3.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,css}": "biome check --no-errors-on-unmatched"
  }
